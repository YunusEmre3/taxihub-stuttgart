# Copy to frontend/.env.local for local overrides (git-ignored).

# Base origin of the Spring Boot backend. Leave EMPTY for local development
# and for the production build that Spring Boot serves itself - both are
# same-origin, and Vite proxies /api to localhost:8080 during `npm run dev`.
#
# Set it only when the frontend is deployed on its own host (Vercel), e.g.
# VITE_API_BASE_URL=https://taxihub-api.example.com
VITE_API_BASE_URL=
